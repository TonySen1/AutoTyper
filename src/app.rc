#include <windows.h>

1 RT_MANIFEST "app.manifest"

// 应用图标
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,1,0
 PRODUCTVERSION  1,0,1,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "AutoTyper"
            VALUE "FileDescription",  "AutoTyper 自动键入工具"
            VALUE "FileVersion",      "1.0.1.0"
            VALUE "InternalName",     "AutoTyper"
            VALUE "LegalCopyright",   "Free to use"
            VALUE "OriginalFilename", "AutoTyper.exe"
            VALUE "ProductName",      "AutoTyper"
            VALUE "ProductVersion",   "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
